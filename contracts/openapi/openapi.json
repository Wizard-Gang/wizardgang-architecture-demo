{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "WizardGang Architecture Demo REST API",
    "version": "2.0.0",
    "description": "Executable OpenAPI 3.1 contract for the WizardGang Architecture Demo: cookie-isolated REST demo records, identity, GraphQL, MCP, webhooks and operations. It is the only published OpenAPI document; the REST demo renders its records operations."
  },
  "servers": [
    {
      "url": "https://demo.wizardgang.ai",
      "description": "Public architecture demo"
    }
  ],
  "tags": [
    {
      "name": "Records",
      "description": "Cookie-isolated visitor records"
    }
  ],
  "paths": {
    "/api/labs/rest-demo-records": {
      "get": {
        "tags": [
          "Records"
        ],
        "operationId": "listRecords",
        "summary": "List records",
        "description": "Return up to 100 records in the current visitor session.",
        "responses": {
          "200": {
            "description": "Records returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "results",
                    "count"
                  ],
                  "properties": {
                    "results": {
                      "type": "array",
                      "description": "Records ordered by key.",
                      "items": {
                        "$ref": "#/components/schemas/Record"
                      }
                    },
                    "count": {
                      "type": "integer",
                      "description": "Number of returned records.",
                      "example": 1
                    }
                  }
                },
                "example": {
                  "results": [
                    {
                      "id": 1,
                      "key": "hello",
                      "value": {
                        "message": "Hello from a Worker"
                      },
                      "createdAt": "2026-09-08T12:00:00.000Z",
                      "updatedAt": "2026-09-08T12:00:00.000Z"
                    }
                  ],
                  "count": 1
                }
              }
            }
          }
        },
        "x-route-id": "platform.d1.rest-demo-records",
        "security": [
          {
            "visitorSession": []
          }
        ]
      },
      "post": {
        "tags": [
          "Records"
        ],
        "operationId": "createRecord",
        "summary": "Create a record",
        "description": "Create a record under a unique key in the current visitor session.",
        "requestBody": {
          "required": true,
          "description": "The key and value for the new record.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordInput"
              },
              "example": {
                "key": "hello",
                "value": {
                  "message": "Hello from a Worker"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Record created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Record"
                },
                "example": {
                  "id": 1,
                  "key": "hello",
                  "value": {
                    "message": "Hello from a Worker"
                  },
                  "createdAt": "2026-09-08T12:00:00.000Z",
                  "updatedAt": "2026-09-08T12:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "Request body or key is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_key",
                  "detail": "key must be 1–64 letters, numbers, dots, underscores, or hyphens."
                }
              }
            }
          },
          "409": {
            "description": "The key already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "record_already_exists",
                  "detail": "POST creates a new resource. Use PUT to replace an existing key."
                }
              }
            }
          }
        },
        "x-route-id": "platform.d1.rest-demo-records",
        "security": [
          {
            "visitorSession": []
          }
        ]
      }
    },
    "/api/labs/rest-demo-records/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The record key.",
          "schema": {
            "type": "string"
          },
          "example": "hello"
        }
      ],
      "get": {
        "tags": [
          "Records"
        ],
        "operationId": "getRecord",
        "summary": "Read a record",
        "description": "Return one record by its key.",
        "responses": {
          "200": {
            "description": "Record returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Record"
                },
                "example": {
                  "id": 1,
                  "key": "hello",
                  "value": {
                    "message": "Hello from a Worker"
                  },
                  "createdAt": "2026-09-08T12:00:00.000Z",
                  "updatedAt": "2026-09-08T12:00:00.000Z"
                }
              }
            }
          },
          "404": {
            "description": "Record does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "record_not_found",
                  "detail": "No record exists for this key."
                }
              }
            }
          }
        },
        "x-route-id": "platform.d1.rest-demo-record",
        "security": [
          {
            "visitorSession": []
          }
        ]
      },
      "put": {
        "tags": [
          "Records"
        ],
        "operationId": "replaceRecord",
        "summary": "Replace a record",
        "description": "Replace the complete representation at a key, creating the record when it does not exist.",
        "requestBody": {
          "required": true,
          "description": "The complete replacement representation.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordReplacement"
              },
              "example": {
                "value": {
                  "message": "Replaced by a Worker"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing record replaced.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Record"
                },
                "example": {
                  "id": 1,
                  "key": "hello",
                  "value": {
                    "message": "Replaced by a Worker"
                  },
                  "createdAt": "2026-09-08T12:00:00.000Z",
                  "updatedAt": "2026-09-08T12:00:00.000Z"
                }
              }
            }
          },
          "201": {
            "description": "Record created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Record"
                },
                "example": {
                  "id": 1,
                  "key": "hello",
                  "value": {
                    "message": "Replaced by a Worker"
                  },
                  "createdAt": "2026-09-08T12:00:00.000Z",
                  "updatedAt": "2026-09-08T12:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "Request body or key is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_json"
                }
              }
            }
          }
        },
        "x-route-id": "platform.d1.rest-demo-record",
        "security": [
          {
            "visitorSession": []
          }
        ]
      },
      "patch": {
        "tags": [
          "Records"
        ],
        "operationId": "updateRecord",
        "summary": "Update a record",
        "description": "Apply the supplied fields without requiring a complete replacement representation.",
        "requestBody": {
          "required": true,
          "description": "Only the fields that should change.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordPatch"
              },
              "example": {
                "value": {
                  "message": "Patched by a Worker",
                  "priority": "high"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing record updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Record"
                },
                "example": {
                  "id": 1,
                  "key": "hello",
                  "value": {
                    "message": "Patched by a Worker",
                    "priority": "high"
                  },
                  "createdAt": "2026-09-08T12:00:00.000Z",
                  "updatedAt": "2026-09-08T12:00:00.000Z"
                }
              }
            }
          },
          "201": {
            "description": "Record created because the supplied key did not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Record"
                },
                "example": {
                  "id": 1,
                  "key": "hello",
                  "value": {
                    "message": "Patched by a Worker",
                    "priority": "high"
                  },
                  "createdAt": "2026-09-08T12:00:00.000Z",
                  "updatedAt": "2026-09-08T12:00:00.000Z"
                }
              }
            }
          },
          "404": {
            "description": "Record does not exist and no value was supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "record_not_found",
                  "detail": "No record exists for this key."
                }
              }
            }
          }
        },
        "x-route-id": "platform.d1.rest-demo-record",
        "security": [
          {
            "visitorSession": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Records"
        ],
        "operationId": "deleteRecord",
        "summary": "Delete a record",
        "description": "Delete one record by its key. Repeating the request is safe.",
        "responses": {
          "204": {
            "description": "Record deleted. The response has no body."
          }
        },
        "x-route-id": "platform.d1.rest-demo-record",
        "security": [
          {
            "visitorSession": []
          }
        ]
      }
    },
    "/auth/microsoft": {
      "get": {
        "summary": "Start Microsoft authorization",
        "description": "Starts OIDC authorization-code flow with state, nonce, and PKCE.",
        "x-route-id": "interfaces.identity.microsoft.start",
        "responses": {
          "303": {
            "description": "Redirect response"
          }
        }
      }
    },
    "/auth/microsoft/callback": {
      "get": {
        "summary": "Microsoft authorization callback",
        "description": "Validates the Microsoft OIDC callback and establishes the application session.",
        "x-route-id": "interfaces.identity.microsoft.callback",
        "responses": {
          "303": {
            "description": "Redirect response"
          }
        }
      }
    },
    "/auth/google": {
      "get": {
        "summary": "Start Google authorization",
        "description": "Starts OIDC authorization-code flow with state, nonce, and PKCE.",
        "x-route-id": "interfaces.identity.google.start",
        "responses": {
          "303": {
            "description": "Redirect response"
          }
        }
      }
    },
    "/auth/google/callback": {
      "get": {
        "summary": "Google authorization callback",
        "description": "Validates the Google OIDC callback and establishes the application session.",
        "x-route-id": "interfaces.identity.google.callback",
        "responses": {
          "303": {
            "description": "Redirect response"
          }
        }
      }
    },
    "/auth/github": {
      "get": {
        "summary": "Start GitHub authorization",
        "description": "Starts OAuth authorization-code flow with state and PKCE.",
        "x-route-id": "interfaces.identity.github.start",
        "responses": {
          "303": {
            "description": "Redirect response"
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "summary": "GitHub authorization callback",
        "description": "Validates the GitHub OAuth callback and provider identity before establishing a session.",
        "x-route-id": "interfaces.identity.github.callback",
        "responses": {
          "303": {
            "description": "Redirect response"
          }
        }
      }
    },
    "/auth/saml": {
      "get": {
        "summary": "Start SAML sign-in",
        "description": "Creates a replay-bound SAML AuthnRequest.",
        "x-route-id": "interfaces.identity.saml.start",
        "responses": {
          "303": {
            "description": "Redirect response"
          }
        }
      }
    },
    "/auth/saml/acs": {
      "post": {
        "summary": "SAML assertion consumer service",
        "description": "Validates signature, issuer, audience, destination, time bounds, RelayState, and replay.",
        "x-route-id": "interfaces.identity.saml.acs",
        "responses": {
          "303": {
            "description": "Redirect response"
          }
        }
      }
    },
    "/auth/saml/metadata": {
      "get": {
        "summary": "SAML service-provider metadata",
        "description": "Returns origin-specific public service-provider metadata.",
        "x-route-id": "interfaces.identity.saml.metadata",
        "responses": {
          "200": {
            "description": "Protocol response"
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "summary": "Current identity session",
        "description": "Returns the disclosure-safe current application session.",
        "x-route-id": "interfaces.identity.session",
        "responses": {
          "200": {
            "description": "Protocol response"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Revoke identity session",
        "description": "Revokes the current application session.",
        "x-route-id": "interfaces.identity.logout",
        "responses": {
          "200": {
            "description": "Protocol response"
          }
        }
      }
    },
    "/auth/token": {
      "post": {
        "summary": "Issue bounded demo access token",
        "description": "Issues a short-lived token derived from the validated identity session.",
        "x-route-id": "interfaces.identity.token",
        "responses": {
          "200": {
            "description": "Protocol response"
          }
        }
      }
    },
    "/auth/authorize": {
      "post": {
        "summary": "Evaluate identity authorization",
        "description": "Evaluates application authorization from the server-derived identity session.",
        "x-route-id": "interfaces.identity.authorize",
        "responses": {
          "200": {
            "description": "Protocol response"
          }
        }
      }
    },
    "/graphql": {
      "get": {
        "summary": "GraphQL endpoint",
        "description": "Executes bounded GraphQL queries.",
        "x-route-id": "interfaces.graphql.endpoint",
        "responses": {
          "200": {
            "description": "Protocol response"
          }
        }
      },
      "post": {
        "summary": "GraphQL endpoint",
        "description": "Executes bounded GraphQL queries and authorized mutations.",
        "x-route-id": "interfaces.graphql.endpoint",
        "responses": {
          "200": {
            "description": "Protocol response"
          }
        }
      }
    },
    "/mcp": {
      "get": {
        "summary": "MCP Streamable HTTP endpoint",
        "description": "MCP protocol transport with origin and authorization enforcement.",
        "x-route-id": "interfaces.mcp.server",
        "responses": {
          "200": {
            "description": "Protocol response"
          }
        }
      },
      "post": {
        "summary": "MCP Streamable HTTP endpoint",
        "description": "MCP protocol transport with origin and authorization enforcement.",
        "x-route-id": "interfaces.mcp.server",
        "responses": {
          "200": {
            "description": "Protocol response"
          }
        }
      },
      "delete": {
        "summary": "MCP Streamable HTTP endpoint",
        "description": "MCP protocol transport with origin and authorization enforcement.",
        "x-route-id": "interfaces.mcp.server",
        "responses": {
          "200": {
            "description": "Protocol response"
          }
        }
      }
    },
    "/webhooks/github": {
      "post": {
        "summary": "GitHub webhook receiver",
        "description": "Verifies exact-body signature, repository and event allowlists, replay, audit, and safe disclosure.",
        "x-route-id": "interfaces.webhooks.github",
        "responses": {
          "202": {
            "description": "Protocol response"
          }
        }
      }
    },
    "/api/operations/health": {
      "get": {
        "summary": "Read runtime and dependency health",
        "x-route-id": "operations.health",
        "responses": {
          "200": {
            "description": "Current health state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "A required dependency is unhealthy.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/operations/version": {
      "get": {
        "summary": "Read deployed version metadata",
        "x-route-id": "operations.version",
        "responses": {
          "200": {
            "description": "Current deployed version and source metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "Read the canonical OpenAPI 3.1 document",
        "x-route-id": "interfaces.openapi.json",
        "responses": {
          "200": {
            "description": "Canonical OpenAPI 3.1 document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "A ten-minute demo token issued after provider sign-in. Its demo:write permission is restricted to the caller's server-derived visitor sandbox. No broad operator bearer credential is accepted by the application."
      },
      "visitorSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wg_demo_session",
        "description": "A signed, HttpOnly visitor-session cookie is issued on the first request and sent on later requests. Keep a cookie jar when using curl so create, read, update, and delete use the same isolated session."
      }
    },
    "schemas": {
      "Record": {
        "type": "object",
        "description": "A stored visitor-scoped record.",
        "required": [
          "id",
          "key",
          "value",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Database identifier.",
            "example": 1
          },
          "key": {
            "type": "string",
            "description": "Stable resource key.",
            "example": "hello"
          },
          "value": {
            "type": "object",
            "description": "Arbitrary JSON-compatible record value.",
            "additionalProperties": true,
            "example": {
              "message": "Hello from a Worker"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC creation timestamp.",
            "example": "2026-09-08T12:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp of the latest change.",
            "example": "2026-09-08T12:02:00.000Z"
          }
        }
      },
      "RecordInput": {
        "type": "object",
        "description": "Representation used to create a record.",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "Unique key containing 1–64 letters, numbers, dots, underscores, or hyphens.",
            "example": "hello"
          },
          "value": {
            "type": "object",
            "description": "Arbitrary JSON-compatible record value.",
            "additionalProperties": true,
            "example": {
              "message": "Hello from a Worker"
            }
          }
        }
      },
      "RecordReplacement": {
        "type": "object",
        "description": "Complete mutable representation used by PUT.",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "object",
            "description": "The complete replacement value.",
            "additionalProperties": true,
            "example": {
              "message": "Replaced by a Worker"
            }
          }
        }
      },
      "RecordPatch": {
        "type": "object",
        "description": "Partial mutable representation used by PATCH.",
        "properties": {
          "value": {
            "type": "object",
            "description": "A replacement value supplied only when it should change.",
            "additionalProperties": true,
            "example": {
              "message": "Patched by a Worker",
              "priority": "high"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "A machine-readable API error.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable error code.",
            "example": "record_not_found"
          },
          "detail": {
            "type": "string",
            "description": "Optional human-readable detail.",
            "example": "No record exists for this key."
          }
        }
      }
    }
  }
}
